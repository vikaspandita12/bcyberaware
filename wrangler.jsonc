{
  "name": "bcyberaware",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  // Scheduled refresh: rebuild the feed every 5 minutes so no visitor waits on sources.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Stored feed snapshot + per-source cache + daily history. No id on purpose:
  // `wrangler deploy` creates the namespace automatically on first deploy.
  // Free plan budget: ~600 writes/day of the 1,000 allowed.
  "kv_namespaces": [{ "binding": "FEED_KV" }],
  // Workers AI — free daily allowance (10,000 neurons/day), no API key required.
  // Powers the "Threat Analyst" chat assistant at /api/chat.
  "ai": { "binding": "AI" },
  "vars": {
    // Swap to "@cf/meta/llama-3.3-70b-instruct-fp8-fast" for higher quality (uses ~6x more neurons)
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // AI-written "In short" line inside action boxes. "hidden": generated and stored but not
    // shown; "visible": shown on the site. Samples were reviewed on 12 Nov 2026 and switched on.
    "AI_ACTION_DETAILS": "visible"
  }
}
